# Pupa — environment variables
#
# Copy this file to `.env` (gitignored) and fill in your own values, OR export
# these in your shell before running `make dev`. The backend will refuse to
# start unless `LLM_PROVIDER` is set and the credentials for the selected
# provider are available.
#
# ---------------------------------------------------------------------------
# Required: LLM provider
# ---------------------------------------------------------------------------
# Which chat model the agent talks to. Must be set.
#
#   LLM_PROVIDER=bedrock             # ChatBedrockConverse via AWS
#   LLM_PROVIDER=anthropic           # ChatAnthropic via the direct Anthropic API
#   LLM_PROVIDER=openai_compatible   # ChatOpenAI pointed at any OpenAI-compatible endpoint
#
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=bedrock: AWS credentials for Bedrock
# ---------------------------------------------------------------------------
# Pick ONE of the two options.
#
# Option A — named profile (recommended). Refreshed by your team's okta/SSO
# tool, written to `~/.aws/credentials` / `~/.aws/config`. Then:
#
#   AWS_PROFILE=your-profile-name
#
# Option B — raw credentials. Useful for CI / one-off runs. Session token is
# required for SSO-issued temporary credentials.
#
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#   AWS_SESSION_TOKEN=...        # only for temporary STS credentials
#
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=openai_compatible: OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# Point the backend at any OpenAI-compatible HTTP endpoint. All three vars
# are required when this provider is selected.
#
# Works with:
#   - OpenAI directly         LLM_BASE_URL=https://api.openai.com/v1
#   - OpenRouter (300+ models) LLM_BASE_URL=https://openrouter.ai/api/v1
#   - CLIProxyAPI / copilot-router (flat-fee subscription proxies)
#   - llama.cpp server        LLM_BASE_URL=http://localhost:8080/v1  LLM_API_KEY=dummy
#   - Ollama                  LLM_BASE_URL=http://localhost:11434/v1 LLM_API_KEY=ollama
#   - LM Studio, vLLM, Jan, and any other OpenAI-compatible local server
#
# Note: Azure OpenAI uses a different URL/auth shape — use LLM_PROVIDER=azure
# (not yet implemented; needs AzureChatOpenAI + AZURE_OPENAI_* vars).
#
# Tool-calling reliability varies. OpenAI GPT-4o/4.1 and Claude-via-proxy
# work well. Quantized local/open-weight models are significantly less
# reliable for structured canvas mutations — test before relying on them.
#
#   LLM_BASE_URL=https://openrouter.ai/api/v1   # endpoint root (no trailing slash)
#   LLM_API_KEY=sk-or-...                        # key for that endpoint
#   LLM_MODEL=anthropic/claude-sonnet-4.6        # model id to request
#
# ---------------------------------------------------------------------------
# Optional: OPENROUTER_API_KEY for the registry `openrouter` provider
# ---------------------------------------------------------------------------
# Distinct from LLM_PROVIDER=openai_compatible above. The `openrouter`
# provider is picker-only: it ships a curated menu of slugs (GLM, Qwen,
# MiniMax, Kimi, DeepSeek) in MODEL_REGISTRY that the iOS client selects per
# request — no LLM_PROVIDER/LLM_MODEL needed, just this key. All slugs route
# through https://openrouter.ai/api/v1.
#
#   OPENROUTER_API_KEY=sk-or-...
#
# ---------------------------------------------------------------------------
# Required when LLM_PROVIDER=anthropic: Anthropic API key
# ---------------------------------------------------------------------------
# Direct Anthropic API key, used by `ChatAnthropic`. Get one at
# https://console.anthropic.com.
#
#   ANTHROPIC_API_KEY=sk-ant-...
#
# ---------------------------------------------------------------------------
# Optional: Frontend → backend wiring
# ---------------------------------------------------------------------------
# Where the CopilotKit Hono runtime should reach the FastAPI backend.
# Defaults to http://localhost:8004.
#
#   BACKEND_URL=http://localhost:8004
#
# ---------------------------------------------------------------------------
# Optional: LangGraph recursion limit
# ---------------------------------------------------------------------------
# Maximum number of graph steps per agent run. LangGraph defaults to 25,
# which trips on legitimate multi-component canvas turns (especially with
# the `write_todos` planning middleware breaking work into multiple passes).
# Defaults to 100 if unset; bump higher if you still hit
# `GraphRecursionError`, lower to catch runaway loops earlier in dev.
#
#   LG_RECURSION_LIMIT=100
#
# ---------------------------------------------------------------------------
# Optional: tool-use pruning trigger
# ---------------------------------------------------------------------------
# Token threshold at which `ClearToolUsesEdit` starts pruning old tool
# messages from the context window (keeps the 3 most recent tool uses).
# Defaults to 40000 if unset. Lower to prune earlier and keep context lean;
# raise if you need more history in long turns.
#
#   LG_CLEAR_TOOL_USES_TRIGGER=40000
#
# ---------------------------------------------------------------------------
# Optional: Web search via Tavily
# ---------------------------------------------------------------------------
# When set, the backend registers a `tavily_search` tool the agent can use to
# look up real-world facts (prices, current events, product specs) mid-turn.
# Without it, the tool is simply not registered and the agent falls back to
# its training data. Get a key at https://app.tavily.com.
#
#   TAVILY_API_KEY=tvly-...
#
# ---------------------------------------------------------------------------
# Optional: Local shell access (ShellToolMiddleware)
# ---------------------------------------------------------------------------
# When set to any non-empty value, the backend wires up `ShellToolMiddleware`,
# letting the agent execute shell commands on the backend host (read files,
# run tests, check git log). Without it the tool is not registered and the
# iOS Settings sheet greys it out.
#
# WARNING: defaults to `HostExecutionPolicy` — the agent inherits full host
# access (your $HOME, your AWS creds, your shell history). Only enable in
# trusted dev environments. To pin the working directory, set SHELL_TOOL_WORKSPACE.
#
# Per-command approval is ON by default whenever SHELL_TOOL_ENABLED is set:
# the agent pauses before each shell call and the iOS client surfaces an
# Approve / Deny card (main chat and Slack sub-agents alike).  The user can
# tick "Always allow" to pre-approve exact command strings for the rest of
# the session, or turn off approval globally via Settings → Security →
# "Require shell approval" (per-device toggle, persisted).
#
#   SHELL_TOOL_ENABLED=1
#   SHELL_TOOL_WORKSPACE=/tmp/pupa-shell   # optional, defaults to a temp dir
#
# Pass the backend's environment to the shell subprocess. Off by default — the
# subprocess gets no inherited env (bare PATH only). Required if startup commands
# need HOME or PATH (e.g. the gh auth wrapper in shell_startup.example.sh).
#
#   SHELL_PASS_ENV=1
#
# Secret-shaped names (*_API_KEY, *TOKEN*, AWS_*, PGPASSWORD, SSH_AUTH_SOCK,
# connection strings, …) are stripped automatically whenever SHELL_PASS_ENV=1 —
# the shell tool is driven by the model, so the default is to withhold. These
# two knobs adjust that set.
#
# Extra names to strip, on top of the automatic ones.
#
#   SHELL_ENV_EXCLUDE=MY_INTERNAL_VAR
#
# Names to forward even though they look secret. For a startup script that
# genuinely needs one credential (e.g. a `gh auth` wrapper) — name it rather
# than turning the default off.
#
#   SHELL_ENV_ALLOW=GH_TOKEN
#
# Path to a shell file (e.g. ~/.zshrc) whose `export VAR=` lines are parsed
# and added to the exclusion set automatically. Useful to exclude all personal
# secrets defined in your shell profile without listing them manually.
#
#   SHELL_ENV_EXCLUDE_FROM=~/.zshrc
#
# Custom startup commands: path to a local shell script whose non-comment lines
# run once when the shell session starts. Defaults to backend/shell_startup.local.sh
# (gitignored). Copy backend/shell_startup.example.sh to get started.
#
#   SHELL_STARTUP_SCRIPT=/path/to/your/shell_startup.local.sh
#
# ---------------------------------------------------------------------------
# Auth — required by default; opt-out for same-laptop dev only
# ---------------------------------------------------------------------------
# The backend requires `Authorization: Bearer <token>` on every non-public
# request by default. Public routes are `/auth/config`, `/auth/pair`, and
# `/health` only.
#
# Operator credential. `PUPA_API_KEY` is what `make pair` uses to authenticate
# against `/auth/pair/begin` and mint a pairing code. **Keep it set:** that
# route accepts nothing else — a paired-device token gets 403, so devices
# can't mint devices and a leaked token can't outlive the revocation of its
# device. Unset it and you can't pair anything new until it's back.
# Generate with `openssl rand -hex 16`. Never paste this into a client.
#
#   PUPA_API_KEY=...
#
# Same-laptop dev opt-out. When set to a truthy value, the middleware skips
# every check — every route becomes wide open. Use only when the backend
# isn't reachable from anywhere outside the laptop (`make backend` +
# `make mac-demo`). Never set this on a tunnel or LAN-exposed backend.
#
#   PUPA_AUTH_DISABLED=1
#
# Refuse plaintext HTTP. Off by default so LAN and offline installs keep
# working; **set it on anything reachable from the internet** — the pairing
# exchange hands the device token over in the clear exactly once. Health
# probes stay exempt. See docs/deploy.md.
#
#   PUPA_REQUIRE_HTTPS=1
#
# Believe `X-Forwarded-For` / `X-Forwarded-Proto`. Inferred automatically for
# `connectivity: tailscale` and `cloudflared` (the backend starts those proxies
# itself); set it explicitly behind any other reverse proxy, including Railway.
# Leave it off on a direct bind — there the headers are written by the caller,
# and believing them would void the rate limits and the HTTPS check.
#
#   PUPA_TRUSTED_PROXY=1
#
# Turn off pairing rate limits. Local loops only — it removes the ceiling on
# guessing pairing codes and operator keys.
#
#   PUPA_RATE_LIMIT_DISABLED=1
#
# ---------------------------------------------------------------------------
# Optional: Live screen-share (macOS-only)
# ---------------------------------------------------------------------------
# When set to a non-empty truthy value, the backend mounts the WebRTC
# signalling broker at `WS /screenshare/ws`. The actual capture happens in a
# separate Swift sidecar (`pupa-backend screenshare`) that uses ScreenCaptureKit — so
# this flag is only meaningful when the backend runs on macOS. On Linux it's a
# no-op (the broker routes are simply not registered).
#
# Defaults to off so Linux deployments incur zero cost.
#
#   PUPA_SCREENSHARE=1
#

# ---------------------------------------------------------------------------
# Optional: SubAgentMiddleware — task-based subagent delegation
# ---------------------------------------------------------------------------
# On by default: the main agent gets a `task` tool to delegate isolated
# sub-tasks to specialist subagents. Uses StateBackend so subagents share
# the main LangGraph state. Subagents are declared in
# backend/backend_tools.py (_build_subagent_middleware).
# Opt out with:
#
#   PUPA_SUBAGENTS_DISABLED=1

# ---------------------------------------------------------------------------
# Optional: Agent skills — progressive disclosure over SKILL.md workflows
# ---------------------------------------------------------------------------
# Agent skills are ON by default. Skills live under ~/.pupa-backend/skills/
# (override with PUPA_SKILLS_DIR) — one subdirectory per skill, each with a
# SKILL.md (YAML frontmatter: name, description). The package ships none; the
# dir starts empty. Names + descriptions are injected into the system prompt
# at agent start; the agent loads a skill's full body on demand via the
# read-only `skill_view` tool. Wired in backend/skills.py (deepagents
# SkillsMiddleware). Turn the feature off entirely with:
#
#   PUPA_SKILLS_DISABLED=1
#   PUPA_SKILLS_DIR=~/.pupa-backend/skills   # default; override if you like

# ---------------------------------------------------------------------------
# Optional: Langfuse tracing
# ---------------------------------------------------------------------------
# Tracing is OPT-OUT: it turns on automatically on every AG-UI request as
# soon as LANGFUSE_PUBLIC_KEY + LANGFUSE_SECRET_KEY are set (both are emitted
# by the Langfuse project settings page). No enable flag is needed.
#
# To turn it OFF while keeping the credentials in the environment:
#   PUPA_LANGFUSE_DISABLED=1
#
# Tracing is a server-side concern — clients say nothing about Langfuse.
# Every trace is derived from identifiers the AG-UI request already carries:
#   trace_id   → AG-UI run_id from the request payload, or a random UUID hex
#   session_id → thread_id  (groups all turns of a conversation)
#
# langfuse is an optional dependency — if the package is not installed tracing
# is silently skipped (a WARNING is logged).
#
#   LANGFUSE_PUBLIC_KEY=pk-lf-...
#   LANGFUSE_SECRET_KEY=sk-lf-...
#   LANGFUSE_BASE_URL=http://localhost:3000   # omit to use Langfuse Cloud
#   PUPA_LANGFUSE_DISABLED=1                   # opt out, keeping creds set

# ---------------------------------------------------------------------------
# Optional: MCP servers (config-driven, gated)
# ---------------------------------------------------------------------------
# Attach any number of MCP servers to the agent — including browser automation
# via @playwright/mcp. The preferred surface is the `mcp_servers:` block in
# ~/.pupa-backend/config.yml (shape mirrors Claude Code's .mcp.json and
# langchain-mcp-adapters' MultiServerMCPClient):
#
#   mcp_servers:
#     atlassian:                     # example: Confluence via community mcp-atlassian
#       command: uvx
#       args: [mcp-atlassian]
#       transport: stdio             # default; omit for stdio
#       description: Confluence search + page read/write   # optional, shown in get_tools
#       env:
#         CONFLUENCE_URL: https://your-domain.atlassian.net/wiki
#         CONFLUENCE_USERNAME: you@corp.com
#         CONFLUENCE_API_TOKEN: ${CONFLUENCE_API_TOKEN}   # ${VAR} from process env
#     playwright:                    # example: browser automation
#       command: npx
#       args: [@playwright/mcp@latest]
#       description: Browser automation — navigate, click, screenshot
#     # remote_http_example:
#     #   url: https://host/mcp
#     #   transport: streamable_http
#     #   headers: { Authorization: "Bearer ${SOME_TOKEN}" }
#
# Manage this block without hand-editing YAML:
#   pupa-backend mcp add                 # interactive wizard (Atlassian + Playwright presets)
#   pupa-backend mcp add --playwright    # Playwright preset, non-interactive
#   pupa-backend mcp list
#   pupa-backend mcp remove atlassian
#
# pupa_config.py serialises the block to the PUPA_MCP_SERVERS env var (JSON);
# you can also set it directly instead of using config.yml:
#   PUPA_MCP_SERVERS={"atlassian":{"command":"uvx","args":["mcp-atlassian"],...}}
#
# Every server's tools start HIDDEN to keep context lean. The agent sees one
# `get_tools(server=...)` gate tool whose description lists the available
# servers; calling it unlocks that server's tools for the session. Per-server
# `enabled: false` skips a server without deleting its block; a server that
# fails to start is logged and skipped — it never blanks the rest of the agent.
#
# Prerequisites on the backend host:
#   1. Install optional dep: pip install 'pupa-backend[mcp]'
#   2. Whatever each server needs to launch:
#      - Atlassian: uv / uvx (https://docs.astral.sh/uv/) + a Confluence Cloud
#        API token (https://id.atlassian.com/manage/api-tokens) exported as
#        CONFLUENCE_API_TOKEN (referenced as ${CONFLUENCE_API_TOKEN}).
#      - Playwright: Node.js + npx, plus browser binaries. Run
#        `make install-playwright` (installs the [playwright] extra and runs
#        `npx --yes playwright install chromium`), or pick Playwright in `make setup`.

# ---------------------------------------------------------------------------
# Optional: AGUIKit (iOS/macOS) verbose logging
# ---------------------------------------------------------------------------
#   AGUIKIT_LOG=1
